SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret

DB_USER=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_queue_db
# Optional: full connection URL (overrides the DB_* values above)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/hospital_queue_db

CORS_ORIGINS=http://localhost:3000
FLASK_ENV=development

# Timezone used for "today", queue hours and analytics (IANA name)
APP_TIMEZONE=Asia/Kolkata
